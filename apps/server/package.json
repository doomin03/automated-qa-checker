{
  "name": "@automated-qa-checker/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/src/main.js",
    "export:openapi": "node dist/scripts/export-openapi.js",
    "check": "pnpm run build && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "ajv": "8.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
    "ajv-formats": "3.0.1",
    "jose": "6.2.14",
    "typescript": "6.0.3"
  }
}
