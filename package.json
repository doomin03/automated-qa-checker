{
  "name": "automated-qa-checker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Automated QA Checker monorepo: web, desktop and platform services",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.34.8 <11"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && node --test tests/boundaries.test.mjs",
    "check:packages": "turbo run check",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "verify": "pnpm run check:foundation && pnpm run lint && pnpm run check-types && pnpm run check:packages && pnpm run spec:validate && pnpm run build && pnpm run test:ui && pnpm run test:routes-ui",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:web": "pnpm --filter @automated-qa-checker/web dev",
    "dev:app": "node scripts/flutter.mjs run -d windows",
    "app:analyze": "node scripts/flutter.mjs analyze",
    "app:test": "node scripts/flutter.mjs test --concurrency=1",
    "app:build": "node scripts/flutter.mjs build windows --release",
    "verify:all": "pnpm run verify && pnpm run test:xml && pnpm run contract:check && pnpm run contract:compatibility && pnpm run test:verification-gates && pnpm run contract:test && pnpm run contract:integration && pnpm run contract:platform-integration && pnpm run app:analyze && pnpm run app:test && pnpm run test:shared-ui && pnpm run test:auth-ui && pnpm run test:workflow-ui && pnpm run test:suite-ui && pnpm run app:integration && pnpm run app:build && pnpm run app:release-record && pnpm run app:release-smoke",
    "build:web": "pnpm --filter @automated-qa-checker/web build",
    "dev:server": "pnpm --filter @automated-qa-checker/server dev",
    "build:server": "pnpm --filter @automated-qa-checker/server build",
    "contract:generate": "pnpm --filter @automated-qa-checker/server build && node packages/contract/generator/contract-tools.mjs generate",
    "contract:check": "pnpm --filter @automated-qa-checker/server build && node packages/contract/generator/contract-tools.mjs check",
    "contract:test": "node --test packages/contract/generator/contract-tools.test.mjs",
    "contract:integration": "node packages/contract/generator/integration.mjs",
    "test:xml": "node --test tests/xml.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "contract:platform-integration": "node packages/contract/generator/platform-integration.mjs",
    "test:shared-ui": "node --test tests/shared-ui.test.mjs",
    "test:auth-ui": "node --test tests/auth-ui.test.mjs",
    "test:workflow-ui": "node --test tests/workflow-ui.test.mjs",
    "lint": "node scripts/lint-source.mjs && pnpm run check:boundaries",
    "check-types": "pnpm --filter @automated-qa-checker/server check-types && pnpm --filter @automated-qa-checker/api-client build",
    "test": "pnpm run check:packages",
    "test:suite-ui": "node --test tests/suite-ui.test.mjs",
    "test:routes-ui": "node --test tests/routes-ui.test.mjs",
    "test:verification-gates": "node --test tests/api-compatibility.test.mjs tests/verify-propagation.test.mjs tests/flutter-wrapper.test.mjs",
    "contract:compatibility": "node scripts/check-api-compatibility.mjs",
    "app:integration": "node scripts/flutter-integration.mjs",
    "app:release-record": "node scripts/record-desktop-release.mjs",
    "app:release-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop-release.ps1",
    "app:desktop-integration": "node scripts/flutter.mjs test integration_test/desktop_ai_test.dart -d windows --dart-define=QA_REPO=C:/workspace/QA/automated-qa-checker",
    "demo:desktop": "node scripts/desktop-demo.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
