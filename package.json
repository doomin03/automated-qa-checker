{
  "name": "automated-qa-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "qa:list": "tsx src/cli/index.ts list",
    "qa:doctor": "tsx src/cli/index.ts doctor",
    "qa:devices": "tsx src/cli/index.ts devices",
    "qa:crawl": "tsx src/cli/index.ts crawl",
    "qa:discover": "tsx src/cli/index.ts discover",
    "qa:scenario": "tsx src/cli/index.ts scenario",
    "qa:run": "tsx src/cli/index.ts run",
    "qa:capture": "tsx src/cli/index.ts capture",
    "qa:coordinate": "tsx src/cli/index.ts coordinate",
    "qa:report": "tsx src/cli/index.ts report"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.54.0",
    "execa": "^9.6.0",
    "fast-xml-parser": "^5.2.5",
    "pino": "^9.7.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.3",
    "webdriverio": "^9.17.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
