{
  "name": "automated-qa-checker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Automated QA Checker monorepo: web, desktop and platform services",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.34.8 <11"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && node --test tests/boundaries.test.mjs",
    "check:packages": "turbo run check",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "verify": "pnpm run check:foundation && pnpm run check:boundaries && pnpm run check:packages && pnpm run spec:validate && pnpm run build && pnpm run test:ui",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:web": "pnpm --filter @automated-qa-checker/web dev",
    "build:web": "pnpm --filter @automated-qa-checker/web build",
    "test:ui": "node --test tests/ui.test.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
