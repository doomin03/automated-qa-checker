  "roleOrder": [
    "viewer",
    "qa_tester",
    "qa_editor",
    "qa_manager",
    "system_admin"
  ],
  "actionPolicy": {
    "viewPublished": {"minimumRole": "viewer"},
    "downloadXml": {"minimumRole": "viewer", "doesExecute": false},
    "pinVersion": {"minimumRole": "qa_tester", "doesExecute": false},
    "pinSuite": {"minimumRole": "qa_tester", "doesExecute": false},
    "createExecution": {"minimumRole": "qa_tester", "successMeans": "queued, not Engine passed"},
    "cancelExecution": {"minimumRole": "qa_tester", "successMeans": "request accepted; inspect terminal state"},
    "createSchedule": {"minimumRole": "qa_tester"},
    "setScheduleEnabled": {"minimumRole": "qa_tester"},
    "updateRunWork": {"minimumRole": "qa_tester", "requires": ["current revision", "active project assignee"]},
    "selectRunBaseline": {"minimumRole": "qa_tester", "requires": ["comparable verified environment"]},
    "createDraft": {"minimumRole": "qa_editor"},
    "reviewDraft": {"minimumRole": "qa_manager", "requires": ["reviewer differs from author", "draft state"]},
    "publishDraft": {"minimumRole": "qa_manager", "requires": ["independent active manager review", "unused version", "idempotency key"]},
    "viewAudit": {"minimumRole": "qa_manager"},
    "enqueueNotification": {"minimumRole": "qa_manager", "requires": ["terminal run", "local-test sink configured"]},
    "viewNotifications": {"minimumRole": "viewer"},
    "recoverExecution": {"minimumRole": "qa_manager", "requires": ["matching fence", "reason", "owner processes stopped", "external sessions stopped"]},
    "manageMembers": {"minimumRole": null, "implemented": false},
    "manageAgentFleet": {"minimumRole": null, "implemented": false}
  },
